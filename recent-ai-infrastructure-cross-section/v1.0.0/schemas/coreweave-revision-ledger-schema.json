{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahasignals.com/data/filing-delta/revision-ledger-schema.json",
  "title": "AhaSignals Filing Revision Ledger",
  "description": "Schema for a frozen, accession-level comparison of matched issuer facts and the research-release scope that includes them.",
  "type": "object",
  "required": [
    "schemaVersion",
    "schemaUrl",
    "artifact",
    "subject",
    "summary",
    "filingComparison",
    "researchReleaseComparison",
    "classificationPolicy",
    "entries",
    "limitations",
    "citation",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "schemaUrl": {
      "type": "string",
      "format": "uri"
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "title",
        "pageUrl",
        "jsonUrl",
        "csvUrl",
        "bibUrl",
        "publishedAt",
        "knowledgeCutoff",
        "license",
        "creator",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "const": "frozen"
        }
      },
      "additionalProperties": true
    },
    "subject": {
      "type": "object",
      "required": [
        "company",
        "ticker",
        "cik"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "entryCount",
        "roundingCompatibleCount",
        "presentationChangeCount",
        "issuerRestatementCount",
        "carriedForwardFromV1Count",
        "addedInV2Count",
        "removedInV2Count"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "entryId",
          "identity",
          "filingComparison",
          "classification",
          "researchReleaseScope"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "required": [
              "label",
              "taxonomy",
              "unit",
              "periodStart",
              "periodEnd"
            ]
          },
          "filingComparison": {
            "type": "object",
            "required": [
              "priorVersion",
              "laterComparative",
              "delta",
              "absoluteDelta",
              "relativeDelta",
              "signChanged"
            ]
          },
          "classification": {
            "type": "object",
            "required": [
              "value",
              "authority",
              "interpretation",
              "roundingGate"
            ]
          },
          "researchReleaseScope": {
            "type": "object",
            "required": [
              "status",
              "firstIncludedReleaseId"
            ]
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "canonicalization",
        "payloadSha256"
      ]
    }
  }
}
